---
interface Props {
  title?: string;
  subtitle?: string;
  currentSlug?: string;
  currentPath?: string;
}

const {
  title = "⚡ Slash Coding Agent Token Costs by 80% with APIVALE",
  subtitle = "Connect Claude Code CLI, Cursor, and Windsurf to official Chinese flagship AI APIs with zero KYC and instant billing.",
  currentSlug = "",
  currentPath = ""
} = Astro.props;

const redirectTarget = currentPath || (currentSlug ? `/blog/${currentSlug}` : '/pricing');
const pricingRedirectUrl = `https://apivel.com/pricing?redirect=${encodeURIComponent(redirectTarget)}&utm_source=apivale_blog&utm_medium=blog_cta_card`;
const signUpRedirectUrl = `https://apivel.com/sign-up?redirect=${encodeURIComponent(redirectTarget)}&utm_source=apivale_blog&utm_medium=blog_cta_card`;
---

<div class="blog-cta-card">
  <div class="cta-gradient-glow"></div>
  <div class="cta-content">
    <div class="cta-header">
      <span class="cta-pill">🎁 ZERO-CARD FREE TRIAL ACTIVE</span>
      <div class="cta-title">{title}</div>
      <p class="cta-subtitle">
        <strong>Zero credit card required. Register in 10s to claim 100,000 Free Tokens ($0.20)</strong> for instant testing in our Web Playground or via Cursor / Claude Code CLI. Test DeepSeek-V4.1, Qwen 3.8, and GLM-5.3 completely free before deciding to recharge!
      </p>
    </div>

    <div class="cta-features">
      <div class="feature-item">
        <span class="feature-icon">⚡</span>
        <span><strong>100,000 Free Starter Tokens</strong> (Zero Credit Card Required)</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">🧪</span>
        <span><strong>Instant Online & CLI Testing</strong> (DeepSeek / Qwen / GLM)</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">🎁</span>
        <span><strong>+50% First Deposit Bonus</strong> (Deposit $5 → Get $7.50 When Ready)</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">💳</span>
        <span><strong>PayPal & Global Cards</strong> (Instant 0s Activation, Zero KYC)</span>
      </div>
    </div>

    <div class="cta-action">
      <div class="cta-btn-group">
        <a href={signUpRedirectUrl} class="cta-btn primary" rel="nofollow">
          <span>🎁 Claim 100,000 Free Tokens (Test Instantly) →</span>
        </a>
        <a href={pricingRedirectUrl} class="cta-btn secondary" rel="nofollow">
          <span>📊 View Model Rates & +50% Bonus</span>
        </a>
      </div>
      <span class="cta-note">✓ Zero KYC • No forced payments • Tokens never expire • Start testing 100% free</span>
    </div>
  </div>
</div>

<style>
  .blog-cta-card {
    position: relative;
    margin: 3rem 0;
    padding: 2rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(17, 24, 39, 0.95) 100%);
    border: 1px solid rgba(99, 102, 241, 0.35);
    box-shadow: 0 10px 30px -10px rgba(99, 102, 241, 0.25);
    overflow: hidden;
  }

  .cta-gradient-glow {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.3) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cta-pill {
    display: inline-block;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .cta-title {
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .cta-subtitle {
    color: #cbd5e1;
    font-size: 0.92rem;
    margin-top: 0.4rem;
    line-height: 1.5;
  }

  .cta-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.75rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: #e2e8f0;
    background: rgba(255, 255, 255, 0.04);
    padding: 0.65rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .feature-icon {
    font-size: 1.05rem;
  }

  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .cta-btn-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.75rem 1.4rem;
    border-radius: 0.65rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cta-btn.primary {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
  }

  .cta-btn.primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
  }

  .cta-btn.secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #f1f5f9;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .cta-btn.secondary:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  .cta-note {
    font-size: 0.78rem;
    color: #94a3b8;
  }

  @media (max-width: 640px) {
    .blog-cta-card {
      padding: 1.25rem;
    }
    .cta-title {
      font-size: 1.15rem;
    }
    .cta-btn {
      width: 100%;
    }
    .cta-btn-group {
      flex-direction: column;
    }
  }
</style>
