---
interface Props {
  title?: string;
  subtitle?: string;
  currentSlug?: string;
  currentPath?: string;
}

const {
  title = "⚡ Slash Coding Agent Token Costs by 80% with APIVALE",
  subtitle = "Connect Claude Code CLI, Cursor, and Windsurf to official Chinese flagship AI APIs with zero KYC and instant billing.",
  currentSlug = "",
  currentPath = ""
} = Astro.props;

const redirectTarget = currentPath || (currentSlug ? `/blog/${currentSlug}` : '/pricing');
const pricingRedirectUrl = `https://apivale.com/pricing?redirect=${encodeURIComponent(redirectTarget)}&utm_source=apivale_blog&utm_medium=blog_cta_card`;
const signUpRedirectUrl = `https://apivale.com/sign-up?redirect=${encodeURIComponent(redirectTarget)}&utm_source=apivale_blog&utm_medium=blog_cta_card`;
---

<div class="blog-cta-card">
  <div class="cta-gradient-glow"></div>
  <div class="cta-content">
    <div class="cta-header">
      <span class="cta-pill">🎁 OFFICIAL WALLET BENEFITS</span>
      <div class="cta-title">{title}</div>
      <p class="cta-subtitle">
        Enjoy instant <strong>PayPal checkout</strong>, global credit cards, Apple Pay, and Alipay with 0 extra foreign exchange fees. Claim your free $0.20 signup credit, plus an automatic <strong>+50% bonus</strong> on your first top-up!
      </p>
    </div>

    <div class="cta-features">
      <div class="feature-item">
        <span class="feature-icon">🎁</span>
        <span><strong>+50% First Deposit Bonus</strong> ($5 → $7.50, $29 → $43.50)</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">🚀</span>
        <span><strong>$29 Developer Pack</strong> (56% OFF, 40M Tokens, Never Expires)</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">⚡</span>
        <span><strong>$0.20 Free Signup Trial</strong> (Zero Card Required)</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">💳</span>
        <span><strong>PayPal Instant Checkout</strong> (Global Zero-FX Cards & Alipay)</span>
      </div>
    </div>

    <div class="cta-action">
      <div class="cta-btn-group">
        <a href={pricingRedirectUrl} class="cta-btn primary">
          <span>Claim +50% Bonus ($5 → $7.50) →</span>
        </a>
        <a href={signUpRedirectUrl} class="cta-btn secondary">
          <span>Get $0.20 Free Trial (Zero Card)</span>
        </a>
      </div>
      <span class="cta-note">Zero KYC. No contract lock-in. Credits never expire.</span>
    </div>
  </div>
</div>

<style>
  .blog-cta-card {
    position: relative;
    margin: 3rem 0;
    padding: 2rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(17, 24, 39, 0.95) 100%);
    border: 1px solid rgba(99, 102, 241, 0.35);
    box-shadow: 0 10px 30px -10px rgba(99, 102, 241, 0.25);
    overflow: hidden;
  }

  .cta-gradient-glow {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.3) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cta-pill {
    display: inline-block;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.4);
    color: #a5b4fc;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .cta-title {
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .cta-subtitle {
    color: #cbd5e1;
    font-size: 0.92rem;
    margin-top: 0.4rem;
    line-height: 1.5;
  }

  .cta-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.75rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: #e2e8f0;
    background: rgba(255, 255, 255, 0.04);
    padding: 0.65rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .feature-icon {
    font-size: 1.05rem;
  }

  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .cta-btn-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.75rem 1.4rem;
    border-radius: 0.65rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cta-btn.primary {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
  }

  .cta-btn.primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
    background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
  }

  .cta-btn.secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #f1f5f9;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .cta-btn.secondary:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  .cta-note {
    font-size: 0.78rem;
    color: #94a3b8;
  }

  @media (max-width: 640px) {
    .blog-cta-card {
      padding: 1.25rem;
    }
    .cta-title {
      font-size: 1.15rem;
    }
    .cta-btn {
      width: 100%;
    }
    .cta-btn-group {
      flex-direction: column;
    }
  }
</style>
