---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "🚀 Instant Access to DeepSeek V4 Pro, Qwen 3.7 Max & GLM-5.2",
  subtitle = "Connect official Chinese AI APIs instantly to Cursor, Claude Code CLI, and OpenAI SDKs with zero KYC."
} = Astro.props;
---

<div class="blog-cta-card">
  <div class="cta-gradient-glow"></div>
  <div class="cta-content">
    <div class="cta-header">
      <span class="cta-pill">🎁 FREE DEVELOPER TRIAL</span>
      <h3 class="cta-title">{title}</h3>
      <p class="cta-subtitle">{subtitle}</p>
    </div>

    <div class="cta-features">
      <div class="feature-item">
        <span class="feature-icon">🎁</span>
        <span><strong>100,000 Free Credits</strong> ($0.20 Trial)</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">🔒</span>
        <span><strong>Zero Prompt Logging</strong> (Strict Privacy)</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">⚡</span>
        <span><strong>Sub-50ms Gateway Latency</strong> (99.9% SLA)</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">💳</span>
        <span><strong>Credits Never Expire</strong> (PayPal Accepted)</span>
      </div>
    </div>

    <div class="cta-action">
      <a href="https://apivale.com/sign-up?redirect=/pricing" class="cta-btn">
        <span>Claim Free Trial API Key →</span>
      </a>
      <span class="cta-note">No credit card required. 10-second instant signup.</span>
    </div>
  </div>
</div>

<style>
  .blog-cta-card {
    position: relative;
    margin: 3rem 0;
    padding: 2rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(30, 27, 75, 0.7) 0%, rgba(17, 24, 39, 0.9) 100%);
    border: 1px solid rgba(99, 102, 241, 0.35);
    box-shadow: 0 10px 30px -10px rgba(99, 102, 241, 0.2);
    overflow: hidden;
  }

  .cta-gradient-glow {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cta-pill {
    display: inline-block;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.4);
    color: #a5b4fc;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .cta-title {
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .cta-subtitle {
    color: #9ca3af;
    font-size: 0.9rem;
    margin-top: 0.4rem;
    line-height: 1.5;
  }

  .cta-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.6rem 0.8rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .feature-icon {
    font-size: 1rem;
  }

  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.65rem;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
    transition: all 0.2s ease;
  }

  .cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
    background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
  }

  .cta-note {
    font-size: 0.78rem;
    color: #6b7280;
  }

  @media (max-width: 640px) {
    .blog-cta-card {
      padding: 1.25rem;
    }
    .cta-title {
      font-size: 1.15rem;
    }
    .cta-btn {
      width: 100%;
    }
  }
</style>
