<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Competitor Pricing Data (Per 1M tokens)
    const competitors = {
      'deepseek-vs-openai': {
        name: 'OpenAI GPT-4o Direct',
        input: 2.50,
        output: 10.00,
        cacheDiscount: 0.50,
        breakdown: 'Input: $2.50/1M · Output: $10.00/1M'
      },
      'deepseek-vs-claude': {
        name: 'Claude 3.5 Sonnet Direct',
        input: 3.00,
        output: 15.00,
        cacheDiscount: 0.90,
        breakdown: 'Input: $3.00/1M · Output: $15.00/1M'
      },
      'deepseek-vs-gemini': {
        name: 'Google Gemini 1.5 Pro Direct',
        input: 1.25,
        output: 5.00,
        cacheDiscount: 0.50,
        breakdown: 'Input: $1.25/1M · Output: $5.00/1M'
      }
    };

    // DeepSeek V4 Rates on APIVALE
    const apivaleRates = {
      input: 0.14,
      output: 0.28,
      cacheDiscount: 0.75
    };

    let activePreset = 'deepseek-vs-openai';
    const presetButtons = document.querySelectorAll('.preset-btn');
    const inputSlider = document.getElementById('inputSlider');
    const outputSlider = document.getElementById('outputSlider');
    const cacheSelect = document.getElementById('cacheSelect');

    const inputValueDisplay = document.getElementById('inputValueDisplay');
    const outputValueDisplay = document.getElementById('outputValueDisplay');
    const competitorTag = document.getElementById('competitorTag');
    const competitorTotalDisplay = document.getElementById('competitorTotalDisplay');
    const competitorBreakdown = document.getElementById('competitorBreakdown');
    const apivaleTotalDisplay = document.getElementById('apivaleTotalDisplay');
    const savingsPctBadge = document.getElementById('savingsPctBadge');
    const copyCurlBtn = document.getElementById('copyCurlBtn');

    function calculateCosts() {
      const inputMillions = parseFloat(inputSlider.value) || 10;
      const outputMillions = parseFloat(outputSlider.value) || 3;
      const cacheRatio = parseFloat(cacheSelect.value) || 0.5;

      if (inputValueDisplay) inputValueDisplay.innerText = `${inputMillions}M Tokens`;
      if (outputValueDisplay) outputValueDisplay.innerText = `${outputMillions}M Tokens`;

      const comp = competitors[activePreset];

      // Calculate Competitor Cost
      const compCachedInput = inputMillions * cacheRatio;
      const compUncachedInput = inputMillions * (1 - cacheRatio);
      const compInputCost = (compUncachedInput * comp.input) + (compCachedInput * comp.input * (1 - comp.cacheDiscount));
      const compOutputCost = outputMillions * comp.output;
      const compTotal = compInputCost + compOutputCost;

      // Calculate APIVALE DeepSeek Cost
      const apiCachedInput = inputMillions * cacheRatio;
      const apiUncachedInput = inputMillions * (1 - cacheRatio);
      const apiInputCost = (apiUncachedInput * apivaleRates.input) + (apiCachedInput * apivaleRates.input * (1 - apivaleRates.cacheDiscount));
      const apiOutputCost = outputMillions * apivaleRates.output;
      const apiTotal = apiInputCost + apiOutputCost;

      // Savings
      const savingsDollars = Math.max(0, compTotal - apiTotal);
      const savingsPct = Math.round((savingsDollars / compTotal) * 100);

      // Render Displays
      if (competitorTag) competitorTag.innerText = comp.name;
      if (competitorBreakdown) competitorBreakdown.innerText = comp.breakdown;
      if (competitorTotalDisplay) competitorTotalDisplay.innerText = `$${compTotal.toFixed(2)}`;
      if (apivaleTotalDisplay) apivaleTotalDisplay.innerText = `$${apiTotal.toFixed(2)}`;
      if (savingsPctBadge) {
        savingsPctBadge.innerText = `🔥 Save ${savingsPct}% ($${savingsDollars.toFixed(2)}/mo)`;
      }
    }

    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        presetButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activePreset = btn.getAttribute('data-model') || 'deepseek-vs-openai';
        calculateCosts();
      });
    });

    if (inputSlider) inputSlider.addEventListener('input', calculateCosts);
    if (outputSlider) outputSlider.addEventListener('input', calculateCosts);
    if (cacheSelect) cacheSelect.addEventListener('change', calculateCosts);

    calculateCosts();

    // Copy cURL demo
    if (copyCurlBtn) {
      copyCurlBtn.addEventListener('click', () => {
        const curlSnippet = `curl https://api.apivale.com/v1/chat/completions \\
  -H "Authorization: Bearer sk-apivale-demo-key" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "deepseek-v4-flash",
    "messages": [{"role": "user", "content": "How much can I save using DeepSeek API on APIVALE?"}]
  }'`;

        navigator.clipboard.writeText(curlSnippet).then(() => {
          const original = copyCurlBtn.innerText;
          copyCurlBtn.innerText = '✅ cURL Copied to Clipboard!';
          setTimeout(() => {
            copyCurlBtn.innerText = original;
          }, 2500);
        });
      });
    }
  });
</script>

