<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('sim-run-btn');
    const requestsInput = document.getElementById('sim-requests');
    const failSelect = document.getElementById('sim-upstream-fail');
    const cacheSelect = document.getElementById('sim-cache-rate');
    const resPrevented = document.getElementById('res-prevented');
    const resSavings = document.getElementById('res-savings');
    const resHours = document.getElementById('res-hours');

    if (btn && requestsInput && failSelect && cacheSelect) {
      btn.addEventListener('click', () => {
        const reqs = parseInt(requestsInput.value, 10) || 50000;
        const failRate = parseFloat(failSelect.value) || 0.05;
        const cacheRate = parseFloat(cacheSelect.value) || 0.75;

        const prevented = Math.round(reqs * failRate);
        const savingsDollars = Math.round(reqs * 0.0075 * cacheRate);
        const hoursSaved = Math.round((prevented / 140) + 5);

        if (resPrevented) resPrevented.textContent = prevented.toLocaleString() + ' requests';
        if (resSavings) resSavings.textContent = '$' + savingsDollars.toLocaleString() + '.00';
        if (resHours) resHours.textContent = hoursSaved + ' hrs/mo';
      });
    }
  });
</script>

