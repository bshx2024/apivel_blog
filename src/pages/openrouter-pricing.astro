<script is:inline>
function runCostSimulation() {
  const model = document.getElementById('calcModelSelect').value;
  const inM = parseFloat(document.getElementById('inputSlider').value);
  const outM = parseFloat(document.getElementById('outputSlider').value);

  document.getElementById('inputDisplay').innerText = inM + 'M tokens';
  document.getElementById('outputDisplay').innerText = outM + 'M tokens';

  let inRate = 3.00, outRate = 15.00, apivaleDiscount = 1.0;
  if (model === 'sonnet') { inRate = 3.00; outRate = 15.00; apivaleDiscount = 1.0; }
  else if (model === 'opus') { inRate = 15.00; outRate = 75.00; apivaleDiscount = 0.833; }
  else if (model === 'deepseek') { inRate = 0.14; outRate = 0.28; apivaleDiscount = 1.0; }
  else if (model === 'qwen') { inRate = 0.60; outRate = 2.40; apivaleDiscount = 0.916; }
  else if (model === 'glm') { inRate = 0.08; outRate = 0.25; apivaleDiscount = 1.0; }
  else if (model === 'mimo') { inRate = 0.20; outRate = 0.60; apivaleDiscount = 1.0; }

  const rawTokenCost = (inM * inRate) + (outM * outRate);
  const cardSurcharge = rawTokenCost * 0.055;
  const openrouterTotal = rawTokenCost + cardSurcharge;
  const apivaleTotal = rawTokenCost * apivaleDiscount;
  const netSavings = Math.max(0, openrouterTotal - apivaleTotal);

  document.getElementById('rawCostText').innerText = '$' + rawTokenCost.toFixed(2);
  document.getElementById('surchargeText').innerText = '+ $' + cardSurcharge.toFixed(2);
  document.getElementById('openrouterTotalText').innerText = '$' + openrouterTotal.toFixed(2);
  document.getElementById('apivaleTotalText').innerText = '$' + apivaleTotal.toFixed(2);
  document.getElementById('savingsDisplayText').innerText = 'Save $' + netSavings.toFixed(2) + ' / mo';
}

document.addEventListener('DOMContentLoaded', () => {
  runCostSimulation();
});
</script>

