---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlogCtaCard from '../components/BlogCtaCard.astro';
import ApiPriceCalculator from '../components/ApiPriceCalculator.astro';
import CliConfigGenerator from '../components/CliConfigGenerator.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
	});
}

const pageTitle = post.data.metaTitle || (post.data.title.includes('APIVALE') ? post.data.title : `${post.data.title} | APIVALE`);

const authorAvatars: Record<string, string> = {
	'Alex Rivera': '/blog/authors/alex-rivera.png',
	'Kenji Tanaka': '/blog/authors/kenji-tanaka.png',
	'Sofia Costa': '/blog/authors/sofia-costa.png',
};
const avatarUrl = authorAvatars[post.data.author];

// Topic and Model detection for widgets and dynamic conversion CTAs
const slugLower = post.id.toLowerCase();
const titleLower = post.data.title.toLowerCase();
const tagsLower = (post.data.tags || []).map((t: string) => t.toLowerCase()).join(' ');
const postMeta = `${slugLower} ${titleLower} ${tagsLower}`;

const isPriceOrBenchmark = /price|cost|saving|benchmark|comparison|versus|vs|deepseek|minimax|rate/i.test(slugLower + ' ' + titleLower);
const isCliOrSetup = /cli|cursor|windsurf|opencode|connect|setup|config|mcp|guide|access|bypass/i.test(slugLower + ' ' + titleLower);

let initialModel = 'glm-5.3-flash';
let targetTopic = 'general';

if (postMeta.includes('flashx') || postMeta.includes('glm-5.3-flashx') || postMeta.includes('glm-5-3-flashx')) {
	targetTopic = 'glm-5.3-flashx';
	initialModel = 'glm-5.3-flashx';
} else if (postMeta.includes('glm-5-3-flash') || postMeta.includes('glm-5.3-flash') || postMeta.includes('ox-alpha') || postMeta.includes('0xalpha')) {
	targetTopic = 'glm-5.3-flash';
	initialModel = 'glm-5.3-flash';
} else if (postMeta.includes('glm-5-3') || postMeta.includes('glm-5.3') || postMeta.includes('glm-5') || postMeta.includes('glm-4') || postMeta.includes('zhipu') || postMeta.includes('z-ai') || postMeta.includes('智谱')) {
	targetTopic = 'zhipu';
	initialModel = 'glm-5.3';
} else if (postMeta.includes('qwen-3-8-omni') || postMeta.includes('qwen-3.8-omni') || postMeta.includes('omni-flash')) {
	targetTopic = 'qwen-3.8-omni';
	initialModel = 'qwen-38-flash';
} else if (postMeta.includes('qwen-3-8-flash') || postMeta.includes('qwen-3.8-flash')) {
	targetTopic = 'qwen-3.8-flash';
	initialModel = 'qwen-38-flash';
} else if (postMeta.includes('qwen') || postMeta.includes('通义千问')) {
	targetTopic = 'qwen';
	initialModel = 'qwen-38';
} else if (postMeta.includes('deepseek') || postMeta.includes('深度求索')) {
	targetTopic = 'deepseek';
	initialModel = 'deepseek-v4';
} else if (postMeta.includes('hunyuan') || postMeta.includes('hy3') || postMeta.includes('hy4') || postMeta.includes('混元')) {
	targetTopic = 'hunyuan';
	initialModel = 'deepseek-v4';
} else if (postMeta.includes('gemini-4') || postMeta.includes('gemini 4')) {
	targetTopic = 'gemini';
	initialModel = 'gemini-37';
} else if (postMeta.includes('gemini') || postMeta.includes('谷歌')) {
	targetTopic = 'gemini';
	initialModel = 'gemini-37';
} else if (postMeta.includes('grok') || postMeta.includes('xai')) {
	targetTopic = 'grok';
	initialModel = 'grok-45';
} else if (postMeta.includes('needle')) {
	targetTopic = 'needle';
	initialModel = 'needle-2';
} else if (postMeta.includes('minimax') || postMeta.includes('hailuo') || postMeta.includes('海螺')) {
	targetTopic = 'minimax';
	initialModel = 'minimax-h3';
} else if (postMeta.includes('kimi') || postMeta.includes('moonshot') || postMeta.includes('月之暗面')) {
	targetTopic = 'kimi';
	initialModel = 'kimi-k3';
} else if (postMeta.includes('opus') || postMeta.includes('claude-opus')) {
	targetTopic = 'claude';
	initialModel = 'claude-opus-5';
} else if (postMeta.includes('sonnet') || postMeta.includes('claude') || postMeta.includes('fable')) {
	targetTopic = 'claude';
	initialModel = 'claude-sonnet-5';
} else if (postMeta.includes('gpt-5.6') || postMeta.includes('gpt-5-6') || postMeta.includes('gpt-6') || postMeta.includes('luna') || postMeta.includes('sol') || postMeta.includes('astra')) {
	targetTopic = 'gpt56';
	initialModel = 'kimi-k3';
} else if (postMeta.includes('cursor') || postMeta.includes('composer') || postMeta.includes('cline') || postMeta.includes('windsurf') || postMeta.includes('opencode')) {
	targetTopic = 'cursor';
	initialModel = 'glm-5.3-flash';
}

let defaultClient = 'claude-code';
if (slugLower.includes('cursor')) defaultClient = 'cursor';
else if (slugLower.includes('windsurf')) defaultClient = 'windsurf';
else if (slugLower.includes('opencode')) defaultClient = 'opencode';

const canonicalPageUrl = `https://apivale.com/blog/${post.id}/`;
const postImageUrl = post.data.image ? (post.data.image.startsWith('http') ? post.data.image : `https://apivale.com${post.data.image}`) : 'https://apivale.com/blog/og-cover.png';

const blogPostingSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "BlogPosting",
			"@id": `${canonicalPageUrl}#article`,
			"isPartOf": {
				"@type": "WebPage",
				"@id": canonicalPageUrl
			},
			"headline": post.data.title,
			"description": post.data.description,
			"image": postImageUrl,
			"datePublished": post.data.date.toISOString(),
			"dateModified": post.data.date.toISOString(),
			"author": {
				"@type": "Person",
				"name": post.data.author,
				"jobTitle": post.data.authorTitle || "Technical Specialist, APIVALE",
				"url": "https://apivale.com/about"
			},
			"publisher": {
				"@type": "Organization",
				"name": "APIVALE",
				"url": "https://apivale.com",
				"logo": {
					"@type": "ImageObject",
					"url": "https://apivale.com/favicon.svg"
				}
			},
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": canonicalPageUrl
			}
		},
		{
			"@type": "BreadcrumbList",
			"@id": `${canonicalPageUrl}#breadcrumb`,
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": "https://apivale.com"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Blog",
					"item": "https://apivale.com/blog/"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": post.data.title,
					"item": canonicalPageUrl
				}
			]
		}
	]
};
interface KeyTakeawayItem {
	label: string;
	value: string;
	isCode?: boolean;
	highlight?: boolean;
}

const keyTakeaways: KeyTakeawayItem[] = (post.data.keyTakeaways && post.data.keyTakeaways.length > 0)
	? post.data.keyTakeaways
	: (() => {
		if (targetTopic === 'gemini') {
			return [
				{ label: 'SDK Compatibility', value: 'OpenAI & Anthropic Native SDKs', isCode: false },
				{ label: 'Target Model', value: 'gemini-3.7-flash / gemini-4-pro', isCode: true },
				{ label: 'Gateway Endpoint', value: 'baseURL: "https://api.apivale.com/v1"', isCode: true },
				{ label: 'Developer Sandbox', value: '$0.20 Free Credit (Zero KYC & Card)', highlight: true }
			];
		} else if (targetTopic === 'qwen') {
			return [
				{ label: 'Flagship Invocation', value: 'infer/qwen3.7-max', isCode: true },
				{ label: 'Target Workflows', value: 'Claude Code CLI, Cursor, Windsurf' },
				{ label: 'Integration Base URL', value: 'https://api.apivale.com/v1', isCode: true },
				{ label: 'Billing & Quota', value: 'Waffo Global Billing ($0.20 Trial)', highlight: true }
			];
		} else if (targetTopic === 'claude') {
			return [
				{ label: 'Protocol Architecture', value: 'Native Anthropic Protocol / Sub-50ms', isCode: false },
				{ label: 'Target Engine', value: 'Claude Sonnet 5 / Claude 3.7', isCode: true },
				{ label: 'CLI Config Variable', value: 'ANTHROPIC_BASE_URL="https://api.apivale.com/v1"', isCode: true },
				{ label: 'Developer Quota', value: '$0.20 Instant Credit (No Card Required)', highlight: true }
			];
		} else if (targetTopic === 'deepseek') {
			return [
				{ label: 'Direct Model Engines', value: 'DeepSeek V4 / DeepSeek R1 Reasoning', isCode: true },
				{ label: 'High-Concurrency Failover', value: 'Multi-Cluster Active Routing (Zero 429)', isCode: false },
				{ label: 'Compatible Endpoint', value: 'https://api.apivale.com/v1', isCode: true },
				{ label: 'Instant Sandbox Access', value: '$0.20 Free Test Credits (No KYC)', highlight: true }
			];
		} else if (targetTopic === 'glm') {
			return [
				{ label: 'Target Model', value: 'infer/glm-5.3 / glm-5.3-flash', isCode: true },
				{ label: 'Developer Tooling', value: 'Claude Code CLI, Cursor .cursorrules', isCode: false },
				{ label: 'API Gateway', value: 'https://api.apivale.com/v1', isCode: true },
				{ label: 'Billing & Onboarding', value: 'Waffo Global Billing ($0.20 Free Trial)', highlight: true }
			];
		} else if (targetTopic === 'cursor') {
			return [
				{ label: 'IDE Integration', value: 'Cursor Custom API Key / OpenAI Format', isCode: false },
				{ label: 'Recommended Models', value: 'Claude Sonnet 5, Qwen 3.7 Max, DeepSeek V4', isCode: false },
				{ label: 'Override Base URL', value: 'https://api.apivale.com/v1', isCode: true },
				{ label: 'Developer Sandbox', value: '$0.20 Free Credit (Zero Card / No KYC)', highlight: true }
			];
		} else {
			return [
				{ label: 'Universal Gateway', value: 'baseURL: "https://api.apivale.com/v1"', isCode: true },
				{ label: 'Supported Ecosystems', value: 'Cursor, Claude Code, Cline, Windsurf', isCode: false },
				{ label: 'Global Billing Rail', value: 'Waffo Global Billing (Zero KYC)', isCode: false },
				{ label: 'Sandbox Quota', value: '$0.20 Developer Credit (No Card Required)', highlight: true }
			];
		}
	})();
---

<Layout 
	title={pageTitle} 
	description={post.data.description}
	image={post.data.image}
	canonicalUrl={canonicalPageUrl}
	schema={blogPostingSchema}
>
	<div class="reading-progress-container"><div class="reading-progress-bar" id="readingProgressBar"></div></div>
	<article class="blog-post">
		<!-- Back to blog -->
		<div class="back-nav">
			<a href="/blog/" class="back-link">← Back to Blog</a>
		</div>

		<!-- Post Header -->
		<header class="post-header">
			<div class="post-tags">
				{post.data.tags.map((tag: string) => (
					<span class="tag-badge">{tag}</span>
				))}
			</div>
			<h1 class="post-title">{post.data.title}</h1>
			
			<div class="post-author-bar">
				<div class="author-avatar">
					{avatarUrl ? (
						<img src={avatarUrl} alt={post.data.author} class="avatar-img" width="48" height="48" />
					) : (
						post.data.author.split(' ').map((n: string) => n[0]).join('')
					)}
				</div>
				<div class="author-meta-info">
					<span class="author-name">{post.data.author}</span>
					<span class="author-title">{post.data.authorTitle}</span>
				</div>
				<div class="divider"></div>
				<div class="post-date">
					<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
				</div>
			</div>
		</header>

		<!-- Answer-First / Key Takeaways & Quick Reference Card (Zero Pogo-Sticking) -->
		<div class="key-takeaways-card">
			<div class="takeaways-header">
				<span class="takeaways-badge">📌 KEY TAKEAWAYS</span>
				<span class="takeaways-title">Quick Technical Reference</span>
			</div>
			<div class="takeaways-grid">
				{keyTakeaways.map((item) => (
					<div class="takeaway-item">
						<div class="item-label">{item.label}</div>
						<div class="item-value">
							{item.isCode ? (
								<code>{item.value}</code>
							) : item.highlight ? (
								<span class="highlight-credit">{item.value}</span>
							) : (
								item.value
							)}
						</div>
					</div>
				))}
			</div>
		</div>

		<!-- Zero-Login Interactive Tool Widgets (Above the Fold) -->
		{isPriceOrBenchmark && (
			<ApiPriceCalculator initialModel={initialModel} />
		)}

		{isCliOrSetup && (
			<CliConfigGenerator defaultClient={defaultClient} defaultModel={initialModel} />
		)}

		<!-- Fallback for general articles if neither matched -->
		{!isPriceOrBenchmark && !isCliOrSetup && (
			<ApiPriceCalculator initialModel={initialModel} />
		)}

		<!-- Post Content -->
		<div class="post-body">
			<Content />
		</div>

		<!-- Dynamic Inline CTA Banner -->
		<div class="dynamic-inline-banner" id="dynamicInlineBanner" data-target-topic={targetTopic} style="display: none;">
			<div class="banner-content">
				<div class="inline-badge" id="inlineBadgeText">💡 Trial Access</div>
				<div class="inline-title" id="inlineTitle">Test APIs Without KYC</div>
				<p class="inline-desc" id="inlineDesc">Sign up via GitHub for instant $0.20 free credit (+ 50% 1st top-up bonus). Access DeepSeek, GLM, and Claude in our playground instantly.</p>
			</div>
			<div class="banner-action">
				<a href="https://apivale.com/sign-in?redirect=%2Fplayground&utm_source=apivale_blog&utm_medium=blog_inline_banner" class="inline-action-btn" id="inlineActionBtn">
					Test Playground
				</a>
			</div>
		</div>

		<!-- Reusable Technical Developer CTA Card -->
		<BlogCtaCard currentSlug={post.id} currentPath={`/blog/${post.id}`} />

		<!-- Post Footer Author Box -->
		<footer class="post-footer">
			<div class="author-box">
				<div class="author-box-avatar">
					{avatarUrl ? (
						<img src={avatarUrl} alt={post.data.author} class="avatar-img" width="60" height="60" />
					) : (
						post.data.author.split(' ').map((n: string) => n[0]).join('')
					)}
				</div>
				<div class="author-box-content">
					<div class="author-box-title">About {post.data.author}</div>
					<p>{post.data.authorBio || `${post.data.author} is a technical contributor at APIVALE.`}</p>
				</div>
			</div>
		</footer>
	</article>

	<!-- Dynamic Floating CTA Card -->
	<div class="dynamic-floating-cta" id="dynamicFloatingCta" data-target-topic={targetTopic} style="display: none;">
		<button class="close-cta-btn" id="closeCtaBtn" aria-label="Close promotion">✕</button>
		<div class="cta-badge">
			<span class="pulse-dot"></span>
			<span id="ctaBadgeText">🎁 Trial Credit</span>
		</div>
		<div class="cta-title" id="ctaTitle">Get Free API Key</div>
		<p class="cta-desc" id="ctaDesc">Sign up via GitHub for instant $0.20 credit (+ 50% bonus). No KYC required.</p>
		<a href="https://apivale.com/sign-in?redirect=%2Fplayground&utm_source=apivale_blog&utm_medium=blog_floating_card" class="cta-action-btn" id="ctaActionBtn">
			Try Playground Instantly
		</a>
	</div>

	<!-- Client-Side Script for dynamic localized copy and content-aware target targeting -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const progressBar = document.getElementById('readingProgressBar');
			if (progressBar) {
				window.addEventListener('scroll', () => {
					const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
					const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
					const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
					progressBar.style.width = scrolled + '%';
				}, { passive: true });
			}
			const ctaContainer = document.getElementById('dynamicFloatingCta');
			const closeBtn = document.getElementById('closeCtaBtn');
			const inlineBanner = document.getElementById('dynamicInlineBanner');
			
			const isClosed = sessionStorage.getItem('apivale_blog_cta_closed') === 'true';

			// Detect Browser Language
			const userLang = navigator.language || navigator.userLanguage || 'en';
			const isZh = userLang.toLowerCase().startsWith('zh');

			// Determine Target Topic (Priority: data attribute injected by Astro server -> fallback to body inspection)
			let topic = ctaContainer?.getAttribute('data-target-topic') || inlineBanner?.getAttribute('data-target-topic') || 'general';

			if (!topic || topic === 'general') {
				const postTitle = document.querySelector('.post-title')?.innerText?.toLowerCase() || '';
				const postBody = document.querySelector('.post-body')?.innerText?.toLowerCase() || '';
				const fullArticleText = postTitle + ' ' + postBody;

				if (fullArticleText.includes('flashx') || fullArticleText.includes('glm-5.3-flashx') || fullArticleText.includes('glm-5-3-flashx')) {
					topic = 'glm-5.3-flashx';
				} else if (fullArticleText.includes('ox-alpha') || fullArticleText.includes('glm-5.3-flash') || fullArticleText.includes('glm-5-3-flash')) {
					topic = 'glm-5.3-flash';
				} else if (fullArticleText.includes('zhipu') || fullArticleText.includes('glm') || fullArticleText.includes('智谱')) {
					topic = 'zhipu';
				} else if (fullArticleText.includes('omni-flash') || fullArticleText.includes('qwen-3.8-omni')) {
					topic = 'qwen-3.8-omni';
				} else if (fullArticleText.includes('qwen') || fullArticleText.includes('通义千问')) {
					topic = 'qwen';
				} else if (fullArticleText.includes('deepseek') || fullArticleText.includes('深度求索')) {
					topic = 'deepseek';
				} else if (fullArticleText.includes('hunyuan') || fullArticleText.includes('混元')) {
					topic = 'hunyuan';
				} else if (fullArticleText.includes('gemini') || fullArticleText.includes('谷歌')) {
					topic = 'gemini';
				} else if (fullArticleText.includes('kimi') || fullArticleText.includes('moonshot') || fullArticleText.includes('月之暗面')) {
					topic = 'kimi';
				} else if (fullArticleText.includes('cursor') || fullArticleText.includes('composer')) {
					topic = 'cursor';
				} else if (fullArticleText.includes('gpt-5.6') || fullArticleText.includes('luna') || fullArticleText.includes('sol')) {
					topic = 'gpt56';
				} else {
					topic = 'general';
				}
			}

			const TOPIC_CONFIG = {
				'glm-5.3-flashx': {
					floating: {
						en: {
							badge: '⚡ 200 TPS Vision',
							title: 'Run GLM-5.3-FlashX at 200 TPS',
							desc: 'Native visual coding for Claude Code & Cursor. Bypass Zhipu KYC limits. Sign up via GitHub for $0.20 free credit (+ 50% 1st top-up bonus).',
							btnText: 'Try GLM-5.3-FlashX Instantly',
							utmCampaign: 'glm53_flashx'
						},
						zh: {
							badge: '⚡ 200 TPS 极速视觉',
							title: '免实名体验 GLM-5.3-FlashX',
							desc: '200 tokens/s 极速视觉编程！直连 Claude Code & Cursor，绕过国内手机号与 Coding Plan 门槛，GitHub 登录即送 $0.20 (+ 50% 首充奖励)。',
							btnText: '一键免登录体验 FlashX →',
							utmCampaign: 'glm53_flashx'
						}
					},
					inline: {
						en: {
							badge: '⚡ FlashX API Pipeline',
							title: 'Connect GLM-5.3-FlashX Vision Coding Endpoints',
							desc: 'Ditch +86 phone verification and Coding Plan barriers. High-concurrency 200 TPS vision-to-code API endpoints. Test in our playground with $0.20 free credit.',
							btnText: 'Test FlashX Playground',
							utmCampaign: 'glm53_flashx'
						},
						zh: {
							badge: '⚡ FlashX 极速多模态',
							title: '想要免实名高速调用 GLM-5.3-FlashX？',
							desc: '200 tokens/s 超高吞吐视觉编程，免去 +86 绑定与官方实名门槛。通过 APIVALE 一键登录获取 $0.20 体验金，支持 Playground 与 API 直连。',
							btnText: '立即免实名测试 FlashX →',
							utmCampaign: 'glm53_flashx'
						}
					}
				},
				'glm-5.3-flash': {
					floating: {
						en: {
							badge: '⚡ Ox Alpha Speed',
							title: 'Call GLM-5.3-Flash (Ox Alpha)',
							desc: 'Next-gen cost-effective coding model. Connect to Claude Code & Cursor at $0.20/M. GitHub signup gives $0.20 free credit (+ 50% top-up bonus).',
							btnText: 'Try GLM-5.3-Flash Now',
							utmCampaign: 'glm53_flash'
						},
						zh: {
							badge: '⚡ Ox Alpha 极速',
							title: '免实名测试 GLM-5.3-Flash',
							desc: '新一代高性价比编程模型 (Ox Alpha)。直连 Claude Code 与 Cursor，跳过实名墙，GitHub 授权即送 $0.20 体验金。',
							btnText: '一键体验 GLM-5.3-Flash →',
							utmCampaign: 'glm53_flash'
						}
					},
					inline: {
						en: {
							badge: '⚡ Ox Alpha High-Speed',
							title: 'Bypass KYC for GLM-5.3-Flash (Ox Alpha)',
							desc: 'Zero +86 phone requirements. Test GLM-5.3-Flash directly in our web playground or fetch API keys for Cursor & Claude Code.',
							btnText: 'Test GLM-5.3-Flash Playground',
							utmCampaign: 'glm53_flash'
						},
						zh: {
							badge: '⚡ Ox Alpha 极速通道',
							title: '想免实名测试 GLM-5.3-Flash (Ox Alpha)？',
							desc: '极致性价比编程模型，跳过复杂的国内实名验证。通过 APIVALE 获得 $0.20 免费额度，支持 Playground 在线测试与 API 直连。',
							btnText: '立即免实名测试 GLM-5.3-Flash →',
							utmCampaign: 'glm53_flash'
						}
					}
				},
				'zhipu': {
					floating: {
						en: {
							badge: '🎁 Trial Credit',
							title: 'Bypass Zhipu KYC Limits',
							desc: 'Ditch +86 phone and ID requirements. Call GLM-5.3 & GLM-4 globally. Sign up with GitHub for $0.20 free credit (+ 50% 1st top-up bonus).',
