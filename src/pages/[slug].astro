---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}
---

<Layout 
	title={post.data.title} 
	description={post.data.description}
	image={post.data.image}
>
	<article class="blog-post">
		<!-- Back to blog -->
		<div class="back-nav">
			<a href="/blog/" class="back-link">← Back to Blog</a>
		</div>

		<!-- Post Header -->
		<header class="post-header">
			<div class="post-tags">
				{post.data.tags.map((tag) => (
					<span class="tag-badge">{tag}</span>
				))}
			</div>
			<h1 class="post-title">{post.data.title}</h1>
			
			<div class="post-author-bar">
				<div class="author-avatar">
					{post.data.author.split(' ').map(n => n[0]).join('')}
				</div>
				<div class="author-meta-info">
					<span class="author-name">{post.data.author}</span>
					<span class="author-title">{post.data.authorTitle}</span>
				</div>
				<div class="divider"></div>
				<div class="post-date">
					<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
				</div>
			</div>
		</header>



		<!-- Post Content -->
		<div class="post-body">
			<Content />
		</div>

		<!-- Dynamic Inline CTA Banner -->
		<div class="dynamic-inline-banner" id="dynamicInlineBanner" style="display: none;">
			<div class="banner-content">
				<div class="inline-badge" id="inlineBadgeText">💡 Trial Access</div>
				<h3 class="inline-title" id="inlineTitle">Test APIs Without KYC</h3>
				<p class="inline-desc" id="inlineDesc">Sign up via GitHub for instant $1.00 free credit. Access DeepSeek, GLM, and Claude in our playground instantly.</p>
			</div>
			<div class="banner-action">
				<a href="https://apivale.com/sign-in?redirect=%2Fplayground&utm_source=apivale_blog&utm_medium=blog_inline_banner" class="inline-action-btn" id="inlineActionBtn">
					Test Playground
				</a>
			</div>
		</div>

		<!-- Post Footer Author Box -->
		<footer class="post-footer">
			<div class="author-box">
				<div class="author-box-avatar">
					{post.data.author.split(' ').map(n => n[0]).join('')}
				</div>
				<div class="author-box-content">
					<h4>About {post.data.author}</h4>
					<p>{post.data.authorBio || `${post.data.author} is a technical contributor at APIVALE.`}</p>
				</div>
			</div>
		</footer>
	</article>

	<!-- Dynamic Floating CTA Card -->
	<div class="dynamic-floating-cta" id="dynamicFloatingCta" style="display: none;">
		<button class="close-cta-btn" id="closeCtaBtn" aria-label="Close promotion">✕</button>
		<div class="cta-badge">
			<span class="pulse-dot"></span>
			<span id="ctaBadgeText">🎁 Trial Credit</span>
		</div>
		<h4 class="cta-title" id="ctaTitle">Get Free API Key</h4>
		<p class="cta-desc" id="ctaDesc">Sign up via GitHub for instant $1.00 credit. No KYC required.</p>
		<a href="https://apivale.com/sign-in?redirect=%2Fplayground&utm_source=apivale_blog&utm_medium=blog_floating_card" class="cta-action-btn" id="ctaActionBtn">
			Try Playground Instantly
		</a>
	</div>

	<!-- Client-Side Script for dynamic localized copy and content-aware target targeting -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			// Floating Card
			const ctaContainer = document.getElementById('dynamicFloatingCta');
			const closeBtn = document.getElementById('closeCtaBtn');
			
			const isClosed = localStorage.getItem('apivale_blog_cta_closed') === 'true';

			// Banner Elements
			const inlineBanner = document.getElementById('dynamicInlineBanner');
			
			// Detect Content Keywords
			const docText = document.body.innerText || '';
			const isZhipu = /zhipu|glm|智谱/i.test(docText);
			const isDeepSeek = /deepseek|hunyuan|混元/i.test(docText);
			const isCursor = /cursor|composer|cline|api key/i.test(docText);
			const isGptCost = /gpt-5\.6|token cost|api cost|tier routing|prompt caching|luna|terra|sol/i.test(docText);

			// Detect Browser Language
			const userLang = navigator.language || navigator.userLanguage || 'en';
			const isZh = userLang.toLowerCase().startsWith('zh');

			// --- 1. Populate Floating CTA ---
			if (ctaContainer && !isClosed) {
				const badgeText = document.getElementById('ctaBadgeText');
				const titleEl = document.getElementById('ctaTitle');
				const descEl = document.getElementById('ctaDesc');
				const actionBtn = document.getElementById('ctaActionBtn');

				let badge = '🎁 Trial Credit';
				let title = 'Get Free API Key';
				let desc = 'Sign up via GitHub for instant $1.00 credit. No KYC required.';
				let btnText = 'Try Playground Instantly';
				let utmCampaign = 'general';

				if (isZh) {
					badge = '🔥 限时体验';
					btnText = '一键免登录体验 Playground →';
					if (isZhipu) {
						title = '免实名测试 Zhipu AI';
						desc = '跳过国内手机号与身份证实名墙。直接调用 GLM-4/5.2 等模型，使用 GitHub 一键登录即刻体验。';
						utmCampaign = 'zhipu_bypass';
					} else if (isDeepSeek) {
						title = '免实名测试 Hunyuan & DeepSeek';
						desc = '免去 +86 手机注册与身份审核。直连 Hunyuan Hy3 / DeepSeek-V4，极速响应免备案。';
						utmCampaign = 'deepseek_bypass';
					} else if (isCursor) {
						title = 'Cursor 专属免实名 API Key';
						desc = '打破 Cursor 订阅次数瓶颈。按 Token 付费使用 DeepSeek / Claude，GitHub 绑定即送 $1.00。';
						utmCampaign = 'cursor_optimization';
					} else {
						title = '免实名一键体验主流 AI';
						desc = '整合 DeepSeek, Claude, GLM 等多款大模型。支持 Stripe / 加密货币充值，新用户即送 $1.00。';
						utmCampaign = 'default';
					}
				} else {
					if (isGptCost) {
						title = 'Route GPT-5.6 Smarter, Pay Less';
						desc = 'Stop routing everything to Sol. Use APIVALE to dynamically switch between Luna, Terra, and Sol — plus Claude and DeepSeek — from a single API key.';
						utmCampaign = 'gpt56_cost';
					} else if (isZhipu) {
						title = 'Bypass Zhipu KYC Limits';
						desc = 'Ditch +86 phone and ID requirements. Call GLM-4/5.2 globally. Sign up with GitHub for $1.00 free credit.';
						utmCampaign = 'zhipu_bypass';
					} else if (isDeepSeek) {
						title = 'Bypass DeepSeek & Hunyuan Blocks';
						desc = 'Get direct REST API endpoints without mainland Chinese verifications. High concurrency and instant trial.';
						utmCampaign = 'deepseek_bypass';
					} else if (isCursor) {
						title = 'Save on Cursor Composer Loops';
						desc = 'Use your own API keys via APIVALE. Prevent throttling, pay-as-you-go, and get $1.00 free signup bonus.';
						utmCampaign = 'cursor_optimization';
					}
				}

				if (badgeText) badgeText.innerText = badge;
				if (titleEl) titleEl.innerText = title;
				if (descEl) descEl.innerText = desc;
				if (actionBtn) {
					actionBtn.innerText = btnText;
					actionBtn.href = `https://apivale.com/sign-in?redirect=%2Fplayground&utm_source=apivale_blog&utm_medium=blog_floating_card&utm_campaign=${utmCampaign}`;
				}

				setTimeout(() => {
					ctaContainer.style.display = 'block';
				}, 1500);
			}

			if (closeBtn && ctaContainer) {
				closeBtn.addEventListener('click', (e) => {
					e.preventDefault();
					ctaContainer.style.display = 'none';
					localStorage.setItem('apivale_blog_cta_closed', 'true');
				});
			}

			// --- 2. Populate Inline Banner ---
			if (inlineBanner) {
				const badgeText = document.getElementById('inlineBadgeText');
				const titleEl = document.getElementById('inlineTitle');
				const descEl = document.getElementById('inlineDesc');
				const actionBtn = document.getElementById('inlineActionBtn');

				let badge = '💡 Trial Access';
				let title = 'Test APIs Without KYC';
				let desc = 'Sign up via GitHub for instant $1.00 free credit. Access DeepSeek, GLM, and Claude in our playground instantly.';
				let btnText = 'Test Playground';
				let utmCampaign = 'general';

				if (isZh) {
					badge = '💡 免实名通道';
					btnText = '立即免登录体验 Playground →';
					if (isZhipu) {
						title = '想免实名测试 Zhipu AI / GLM 模型？';
						desc = '通过 APIVALE 绕过复杂的实名墙与 +86 手机绑定。绑定 GitHub 即可获得 $1.00 免费额度，支持在浏览器中即开即用进行测试，无需实名！';
						utmCampaign = 'zhipu_bypass';
					} else if (isDeepSeek) {
						title = '想免实名测试 Hunyuan 或 DeepSeek 接口？';
						desc = '免去官方实名认证阻碍。通过 APIVALE 一键登录即可获得 $1.00 体验金，直接在控制台 Playground 进行模型调试与接口调用。';
						utmCampaign = 'deepseek_bypass';
					} else if (isCursor) {
						title = '在 Cursor 中配置你自己的 API Key';
						desc = '拒绝高额订阅，拒绝限流。使用 APIVALE 代理，支持 Stripe 和加密货币全球充值，绑定 GitHub 免费体验 $1.00 起步额度。';
						utmCampaign = 'cursor_optimization';
					} else {
						title = '免实名一键测试国内主流大模型';
						desc = '聚合 DeepSeek、Hunyuan、Zhipu GLM 以及 Claude 3.5 Sonnet。新用户授权登录送 $1.00 起步额度，免去各项限制。';
						utmCampaign = 'default';
					}
				} else {
					if (isGptCost) {
						title = 'Cut Your GPT-5.6 Bill by 8x';
						desc = 'Route simple tasks to Luna ($1/M), keep complex reasoning on Sol ($5/M). One APIVALE key, 10+ models, real-time cost tracking. Get $1.00 free to start.';
						utmCampaign = 'gpt56_cost';
					} else if (isZhipu) {
						title = 'Bypass Zhipu AI KYC Today';
						desc = 'Get $1.00 starting bonus upon GitHub registration. Test GLM-4 and GLM-5.2 in our online playground without any Chinese phone verification.';
						utmCampaign = 'zhipu_bypass';
					} else if (isDeepSeek) {
						title = 'Call DeepSeek & Hunyuan Globally';
						desc = 'No mainland KYC or identity blocks. Get instant credit on registration and start playing with frontier Chinese LLMs immediately.';
						utmCampaign = 'deepseek_bypass';
					} else if (isCursor) {
						title = 'Reduce Cursor API Costs by 95%';
						desc = 'Switch Cursor base URL to APIVALE and use pay-as-you-go keys. Zero monthly fixed subscription, high concurrency, and free trial credit.';
						utmCampaign = 'cursor_optimization';
					}
				}

				if (badgeText) badgeText.innerText = badge;
				if (titleEl) titleEl.innerText = title;
				if (descEl) descEl.innerText = desc;
				if (actionBtn) {
					actionBtn.innerText = btnText;
					actionBtn.href = `https://apivale.com/sign-in?redirect=%2Fplayground&utm_source=apivale_blog&utm_medium=blog_inline_banner&utm_campaign=${utmCampaign}`;
				}

				inlineBanner.style.display = 'block';
			}
		});
	</script>
</Layout>

<style is:global>
	/* Blog Post Layout */
	.blog-post {
		max-width: 800px;
		margin: 0 auto;
		padding: 1rem 0 4rem;
	}

	.back-nav {
		margin-bottom: 2rem;
	}

	.back-link {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		transition: color 0.2s;
	}

	.back-link:hover {
		color: var(--primary-color);
	}

	.post-header {
		margin-bottom: 2.5rem;
		border-bottom: 1px solid var(--surface-border);
		padding-bottom: 2.5rem;
	}

	.post-cover-wrapper {
		width: 100%;
		overflow: hidden;
		border-radius: 12px;
		border: 1px solid var(--surface-border);
		margin-bottom: 3rem;
	}

	.post-cover-image {
		width: 100%;
		height: auto;
		display: block;
	}

	.post-tags {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
		flex-wrap: wrap;
	}

	.post-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 2.5rem;
		line-height: 1.25;
		color: var(--text-primary);
		margin-bottom: 1.75rem;
		letter-spacing: -0.015em;
	}

	.post-author-bar {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.author-meta-info {
		display: flex;
		flex-direction: column;
	}

	.author-meta-info .author-name {
		color: var(--text-primary);
		font-weight: 600;
		font-size: 0.9rem;
	}

	.author-meta-info .author-title {
		color: var(--text-muted);
		font-size: 0.75rem;
	}

	.post-author-bar .divider {
		width: 1px;
		height: 24px;
		background-color: var(--surface-border);
	}

	.post-date {
		font-size: 0.85rem;
		color: var(--text-secondary);
	}

	/* Rendered Markdown Body Styling */
	.post-body {
		color: #d1d5db; /* Light grayish text for easy reading on dark backgrounds */
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.post-body h2 {
		font-family: var(--font-display);
		color: var(--text-primary);
		font-size: 1.75rem;
		font-weight: 700;
		margin: 3rem 0 1.25rem;
		letter-spacing: -0.01em;
	}

	.post-body h3 {
		font-family: var(--font-display);
		color: var(--text-primary);
		font-size: 1.35rem;
		font-weight: 600;
		margin: 2.25rem 0 1rem;
	}

	.post-body p {
		margin-bottom: 1.5rem;
	}

	.post-body code {
		font-family: var(--font-mono);
		font-size: 0.85em;
		background-color: rgba(255, 255, 255, 0.06);
		padding: 0.2rem 0.4rem;
		border-radius: 4px;
		color: #e879f9;
	}

	.post-body pre {
		background-color: #0d1117 !important; /* Shiki theme fallback or override */
		border: 1px solid var(--surface-border);
		border-radius: 8px;
		padding: 1.25rem;
		margin: 1.5rem 0 2rem;
		overflow-x: auto;
	}

	.post-body pre code {
		background-color: transparent;
		padding: 0;
		border-radius: 0;
		color: inherit;
		font-size: 0.9em;
	}

	.post-body blockquote {
		border-left: 4px solid var(--primary-color);
		background-color: rgba(99, 102, 241, 0.04);
		padding: 1.25rem 1.5rem;
		margin: 2rem 0;
		border-radius: 0 8px 8px 0;
	}

	.post-body blockquote p {
		margin: 0;
		font-style: italic;
		color: #e5e7eb;
	}

	/* Expert quote citation style */
	.post-body blockquote + p {
		margin-top: -1.5rem;
		margin-bottom: 2rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		text-align: right;
		font-style: normal;
	}

	.post-body ul, .post-body ol {
		margin: 0 0 1.5rem 1.5rem;
	}

	.post-body li {
		margin-bottom: 0.5rem;
	}

	.post-body table {
		width: 100%;
		border-collapse: collapse;
		margin: 2rem 0;
		font-size: 0.95rem;
	}

	.post-body th, .post-body td {
		border: 1px solid var(--surface-border);
		padding: 0.75rem 1rem;
		text-align: left;
	}

	.post-body th {
		background-color: rgba(255, 255, 255, 0.02);
		color: var(--text-primary);
		font-weight: 600;
	}

	.post-body tr:nth-child(even) {
		background-color: rgba(255, 255, 255, 0.01);
	}

	.post-body hr {
		border: 0;
		border-top: 1px solid var(--surface-border);
		margin: 3rem 0;
	}

	.post-body img {
		max-width: 100%;
		height: auto;
		display: block;
		margin: 2.5rem auto 0.75rem;
		border-radius: 8px;
		border: 1px solid var(--surface-border);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
	}

	.post-body img + em {
		display: block;
		text-align: center;
		font-size: 0.85rem;
		color: var(--text-muted);
		margin-bottom: 2.5rem;
		font-style: normal;
	}

	/* Footer Author Box */
	.post-footer {
		margin-top: 4rem;
		padding-top: 3rem;
		border-top: 1px solid var(--surface-border);
	}

	.author-box {
		background-color: var(--surface-color);
		border: 1px solid var(--surface-border);
		border-radius: 8px;
		padding: 2rem;
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}

	.author-box-avatar {
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
		color: var(--text-primary);
		font-weight: 700;
		font-size: 1.25rem;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.author-box-content h4 {
		font-family: var(--font-display);
		color: var(--text-primary);
		font-size: 1.1rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.author-box-content p {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.5;
	}

	@media (max-width: 640px) {
		.post-title {
			font-size: 2rem;
		}
		.author-box {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
	}

	/* Premium CRO CTA Card Styles */
	.cta-card {
		background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(236, 72, 153, 0.05) 100%);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 2rem;
		margin: 2.5rem 0;
		position: relative;
		overflow: hidden;
		box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
	}

	.cta-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, #6366f1, #ec4899);
	}

	.cta-card-title {
		font-family: var(--font-display);
		color: #ffffff !important;
		font-size: 1.35rem !important;
		font-weight: 700 !important;
		margin-top: 0 !important;
		margin-bottom: 0.75rem !important;
	}

	.cta-card-text {
		color: #9ca3af;
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.cta-card-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.cta-primary-btn {
		background: linear-gradient(90deg, #6366f1, #ec4899);
		color: #ffffff !important;
		font-weight: 600;
		font-size: 0.95rem;
		padding: 0.75rem 1.5rem;
		border-radius: 6px;
		text-decoration: none !important;
		transition: transform 0.2s, box-shadow 0.2s;
		box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
		display: inline-block;
	}

	.cta-primary-btn:hover {
		transform: translateY(-1px);
		box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
	}

	.cta-secondary-btn {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #e5e7eb !important;
		font-weight: 600;
		font-size: 0.95rem;
		padding: 0.75rem 1.5rem;
		border-radius: 6px;
		text-decoration: none !important;
		transition: background 0.2s, border-color 0.2s;
		display: inline-block;
	}

	.cta-secondary-btn:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.2);
	}

	/* Dynamic Inline CTA Banner */
	.dynamic-inline-banner {
		background: linear-gradient(135deg, rgba(99, 102, 241, 0.04) 0%, rgba(236, 72, 153, 0.04) 100%);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-left: 4px solid var(--primary-color);
		border-radius: 8px;
		padding: 2rem;
		margin: 3rem 0;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
	}

	.banner-content {
		flex: 1;
	}

	.inline-badge {
		display: inline-block;
		background: rgba(99, 102, 241, 0.12);
		border: 1px solid rgba(99, 102, 241, 0.25);
		border-radius: 4px;
		padding: 0.2rem 0.5rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: #a5b4fc;
		margin-bottom: 0.75rem;
	}

	.inline-title {
		font-family: var(--font-display);
		color: #ffffff !important;
