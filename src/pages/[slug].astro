					ctaContainer.style.transition = 'opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
					requestAnimationFrame(() => {
						ctaContainer.style.opacity = '1';
						ctaContainer.style.transform = 'translateY(0)';
					});
				};

				// Trigger 1: Deep scroll (35% of article depth, ensuring user is genuinely reading)
				const handleScrollTrigger = () => {
					const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
					if (scrollTotal > 0 && (window.scrollY / scrollTotal) >= 0.35) {
						showCtaSmoothly();
						window.removeEventListener('scroll', handleScrollTrigger);
					}
				};
				window.addEventListener('scroll', handleScrollTrigger, { passive: true });

				// Trigger 2: High engagement time (reading continuously for 25s without interruption)
				setTimeout(() => {
					showCtaSmoothly();
				}, 25000);
			}

