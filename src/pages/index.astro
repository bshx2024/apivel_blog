---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Retrieve and sort blog posts by date descending
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}

const authorAvatars: Record<string, string> = {
	'Alex Rivera': '/blog/authors/alex-rivera.png',
	'Kenji Tanaka': '/blog/authors/kenji-tanaka.png',
	'Sofia Costa': '/blog/authors/sofia-costa.png',
	'Elena Rostova': '/blog/authors/elena-rostova.png',
	'Priya Sharma': '/blog/authors/priya-sharma.png',
};

const featuredPost = sortedPosts.length > 0 ? sortedPosts[0] : null;
const remainingPosts = sortedPosts.length > 1 ? sortedPosts.slice(1) : [];
---

<Layout title="Insights & API Tutorials | apivel">
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="hero-glow-1"></div>
		<div class="hero-glow-2"></div>
		<div class="hero-content">
			<span class="hero-tag">ENGINEERING & PROTOCOL HUB</span>
			<h1>apivel Engineering Blog</h1>
			<p>Deep dives, tutorials, and benchmarking analysis for building scalable AI products using low-latency unified API routing.</p>
			
			<!-- Breaking Hot SOTA Banner Pill -->
			<div class="featured-badge-banner">
				<a href="/blog/claude-code-rea-setup-limits-cost/" class="featured-banner-link">
					<span class="badge-fire">🔥 BREAKING SOTA</span>
					<span class="badge-text">Claude Code REA Setup: Fix Tool Limits & Cut Token Costs by 85%</span>
					<span class="badge-arrow">→</span>
				</a>
			</div>

			<!-- Topic Filter Pills Bar -->
			<div class="topics-filter-bar">
				<span class="filter-pill active">All Topics <span class="pill-count">{sortedPosts.length}</span></span>
				<a href="/blog/claude-code-rea-setup-limits-cost/" class="filter-pill">Claude Code REA</a>
				<a href="/blog/claude-code-rea-setup-limits-cost/#qwen-deepseek-architecture" class="filter-pill">DeepSeek V4 & Qwen 3.8</a>
				<a href="/blog/claude-code-rea-setup-limits-cost/#troubleshooting-matrix" class="filter-pill">Tool Limits Workaround</a>
				<a href="/openrouter-pricing/" class="filter-pill">Pricing Benchmark</a>
				<a href="/llm-gateway/" class="filter-pill">LLM Gateway</a>
			</div>
		</div>
	</section>

	<!-- Main Content Section -->
	<section class="posts-section">
		{sortedPosts.length === 0 ? (
			<div class="no-posts-container">
				<p class="no-posts-title">Stay Tuned — Fresh Engineering Insights Arriving Soon</p>
				<p class="no-posts-desc">Our team is crafting comprehensive API benchmarks, integration guides, and cost optimization blueprints.</p>
			</div>
		) : (
			<div class="articles-container">
				<!-- 1. Featured Spotlight Card -->
				{featuredPost && (
					<div class="featured-spotlight-wrapper">
						<article class="featured-card">
							<div class="featured-card-glow"></div>
							<div class="featured-grid">
								<!-- Left Column: Editorial Meta & Summary -->
								<div class="featured-left">
									<div class="featured-meta">
										<div class="meta-badges">
											<span class="spotlight-badge">⭐ FEATURED BLUEPRINT</span>
											<span class="tag-badge">REA</span>
											<span class="tag-badge">Claude Code</span>
										</div>
										<time datetime={featuredPost.data.date.toISOString()}>
											{formatDate(featuredPost.data.date)} · <span class="read-time">⏱️ 8 min read</span>
										</time>
									</div>

									<h2 class="featured-title">
										<a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
									</h2>

									<p class="featured-description">{featuredPost.data.description}</p>

									<!-- Key Tech Gains Badges -->
									<div class="tech-spec-grid">
										<div class="spec-item">
											<span class="spec-icon">⚡</span>
											<span class="spec-text"><strong>Native URL</strong>: https://apivel.com/v1</span>
										</div>
										<div class="spec-item">
											<span class="spec-icon">💰</span>
											<span class="spec-text"><strong>85% Off</strong> vs Claude 3.5 Sonnet</span>
										</div>
										<div class="spec-item">
											<span class="spec-icon">🛡️</span>
											<span class="spec-text"><strong>Uncapped</strong> TPM & 1M Window</span>
										</div>
										<div class="spec-item">
											<span class="spec-icon">💳</span>
											<span class="spec-text"><strong>PayPal</strong> & Global Cards ($0.20 Trial)</span>
										</div>
									</div>

									<!-- Author & CTA Button -->
									<div class="featured-footer">
										<div class="card-author">
											<div class="author-avatar">
												{authorAvatars[featuredPost.data.author] ? (
													<img src={authorAvatars[featuredPost.data.author]} alt={featuredPost.data.author} class="avatar-img" />
												) : (
													featuredPost.data.author.split(' ').map(n => n[0]).join('')
												)}
											</div>
											<div class="author-info">
												<span class="author-name">{featuredPost.data.author}</span>
												<span class="author-title">{featuredPost.data.authorTitle}</span>
											</div>
										</div>

										<a href={`/blog/${featuredPost.id}/`} class="btn-read-featured">
											Read Full Blueprint →
										</a>
									</div>
								</div>

								<!-- Right Column: Interactive Code Quickstart Terminal -->
								<div class="featured-right">
									<div class="terminal-mockup">
										<div class="terminal-header">
											<div class="terminal-dots">
												<span class="dot dot-red"></span>
												<span class="dot dot-yellow"></span>
												<span class="dot dot-green"></span>
											</div>
											<span class="terminal-title">bash — apivel-claude-code-quickstart</span>
											<span class="terminal-badge">READY</span>
										</div>
										<div class="terminal-body">
											<div class="terminal-comment"># 1. Override Claude Code Endpoint with apivel</div>
											<div class="terminal-line"><span class="cmd-prompt">$</span> <span class="cmd-env">export</span> <span class="cmd-var">ANTHROPIC_BASE_URL</span>=<span class="cmd-str">"https://apivel.com/v1"</span></div>
											<div class="terminal-line"><span class="cmd-prompt">$</span> <span class="cmd-env">export</span> <span class="cmd-var">ANTHROPIC_API_KEY</span>=<span class="cmd-str">"sk-apivel-live-prod"</span></div>
											
											<div class="terminal-comment" style="margin-top: 0.75rem;"># 2. Run unthrottled REA MCP decompile session</div>
											<div class="terminal-line"><span class="cmd-prompt">$</span> claude -p <span class="cmd-str">"Reverse engineer ./binary using REA"</span></div>

											<div class="terminal-output">
												<span class="status-icon">✓</span> Routing via DeepSeek V4 & Qwen 3.8 Max<br/>
												<span class="status-icon">✓</span> Zero Rate Limits | Context: 1M Tokens<br/>
												<span class="status-icon">✓</span> Cost: $0.18/hr (Saved 85% vs Official API)
											</div>
										</div>
										<div class="terminal-footer">
											<span class="term-tag">⚡ 280ms TTFT</span>
											<span class="term-tag">🛡️ Zero KYC</span>
											<span class="term-tag highlight">🎁 $0.20 Free Quota Included</span>
										</div>
									</div>
								</div>
							</div>
						</article>
					</div>
				)}

				<!-- 2. Subsequent Posts Grid (Visible if more than 1 article) -->
				{remainingPosts.length > 0 && (
					<div class="subsequent-posts-section">
						<h3 class="section-divider-title">More Engineering Analyses</h3>
						<div class="posts-grid">
							{remainingPosts.map((post) => {
								const avatarUrl = authorAvatars[post.data.author];
								return (
									<article class="post-card">
										<div class="card-glow"></div>
										<div class="card-content">
											<div class="card-meta">
												<div class="card-tags">
													{post.data.tags.slice(0, 2).map((tag) => (
														<span class="tag-badge">{tag}</span>
													))}
												</div>
												<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
											</div>
											
											<h3 class="card-title">
												<a href={`/blog/${post.id}/`}>{post.data.title}</a>
											</h3>
											
											<p class="card-description">{post.data.description}</p>
											
											<div class="card-author">
												<div class="author-avatar">
													{avatarUrl ? (
														<img src={avatarUrl} alt={post.data.author} class="avatar-img" />
													) : (
														post.data.author.split(' ').map(n => n[0]).join('')
													)}
												</div>
												<div class="author-info">
													<span class="author-name">{post.data.author}</span>
													<span class="author-title">{post.data.authorTitle}</span>
												</div>
											</div>
										</div>
									</article>
								);
							})}
						</div>
					</div>
				)}
			</div>
		)}
	</section>
</Layout>

<style>
	/* Hero Section */
	.hero-section {
		position: relative;
		padding: 3.5rem 0 2.5rem;
		text-align: center;
		overflow: hidden;
	}

	.hero-glow-1 {
		position: absolute;
		top: -10%;
		left: 20%;
		width: 350px;
		height: 350px;
		background: radial-gradient(circle, var(--primary-color) 0%, transparent 70%);
		opacity: 0.18;
		filter: blur(60px);
		pointer-events: none;
	}

	.hero-glow-2 {
		position: absolute;
		bottom: -10%;
		right: 20%;
		width: 350px;
		height: 350px;
		background: radial-gradient(circle, var(--accent-color) 0%, transparent 70%);
		opacity: 0.18;
		filter: blur(60px);
		pointer-events: none;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 820px;
		margin: 0 auto;
	}

	.hero-tag {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		text-transform: uppercase;
		display: inline-block;
		margin-bottom: 0.85rem;
	}

	.hero-section h1 {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 3rem;
		color: var(--text-primary);
		line-height: 1.15;
		margin-bottom: 1rem;
		letter-spacing: -0.025em;
	}

	.hero-section p {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.6;
		max-width: 680px;
		margin: 0 auto;
	}

	/* Breaking SOTA Banner Pill */
	.featured-badge-banner {
		margin-top: 1.5rem;
		display: inline-block;
	}

	.featured-banner-link {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.55rem 1.25rem;
		background: rgba(99, 102, 241, 0.12);
		border: 1px solid rgba(99, 102, 241, 0.4);
		border-radius: 9999px;
		color: var(--text-primary);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
	}

	.featured-banner-link:hover {
		background: rgba(99, 102, 241, 0.22);
		border-color: rgba(99, 102, 241, 0.7);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(99, 102, 241, 0.25);
	}

	.badge-fire {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		background: linear-gradient(135deg, #f59e0b, #ef4444);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		letter-spacing: 0.05em;
	}

	.badge-text {
		color: #f1f5f9;
		font-weight: 500;
	}

	.badge-arrow {
		color: var(--primary-color);
		font-weight: 700;
		transition: transform 0.2s ease;
	}

	.featured-banner-link:hover .badge-arrow {
		transform: translateX(3px);
	}

	/* Topic Filter Bar */
	.topics-filter-bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 2rem;
	}

	.filter-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.85rem;
		background: rgba(17, 24, 39, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 9999px;
		font-size: 0.8rem;
		color: var(--text-secondary);
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.filter-pill:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.2);
		color: var(--text-primary);
		transform: translateY(-1px);
	}

	.filter-pill.active {
		background: rgba(99, 102, 241, 0.18);
		border-color: rgba(99, 102, 241, 0.5);
		color: #a5b4fc;
		font-weight: 600;
	}

	.pill-count {
		font-size: 0.7rem;
		background: rgba(99, 102, 241, 0.3);
		color: #e0e7ff;
		padding: 0.1rem 0.35rem;
		border-radius: 9999px;
	}

	/* Main Posts Section */
	.posts-section {
		margin-top: 1.5rem;
		padding-bottom: 5rem;
		max-width: 1200px;
		margin-left: auto;
		margin-right: auto;
	}

	/* 1. Featured Spotlight Card (Dual Column) */
	.featured-spotlight-wrapper {
		margin-bottom: 3.5rem;
	}

	.featured-card {
		position: relative;
		background: linear-gradient(145deg, rgba(17, 24, 39, 0.85), rgba(15, 23, 42, 0.75));
		border: 1px solid rgba(99, 102, 241, 0.3);
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 30px rgba(99, 102, 241, 0.08);
		backdrop-filter: blur(16px);
		transition: all 0.3s ease;
	}

	.featured-card:hover {
		border-color: rgba(99, 102, 241, 0.6);
		box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6), 0 0 40px rgba(99, 102, 241, 0.15);
	}

	.featured-card-glow {
		position: absolute;
		top: 0;
		right: 0;
		width: 450px;
		height: 450px;
		background: radial-gradient(circle, rgba(99, 102, 241, 0.15), transparent 70%);
		pointer-events: none;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 2.5rem;
		padding: 2.5rem;
		align-items: center;
	}

	.featured-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.meta-badges {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.spotlight-badge {
		font-size: 0.7rem;
		font-weight: 700;
		background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(239, 68, 68, 0.2));
		border: 1px solid rgba(245, 158, 11, 0.4);
		color: #fcd34d;
		padding: 0.25rem 0.6rem;
		border-radius: 9999px;
		letter-spacing: 0.05em;
	}

	.featured-meta time {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.read-time {
		color: #38bdf8;
		font-weight: 600;
	}

	.featured-title {
		font-family: var(--font-display);
		font-size: 1.85rem;
		font-weight: 700;
		line-height: 1.3;
		margin-bottom: 1rem;
		letter-spacing: -0.015em;
	}

	.featured-title a {
		color: #ffffff;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.featured-title a:hover {
		color: #818cf8;
	}

	.featured-description {
		font-size: 1rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	/* Tech Spec Grid */
	.tech-spec-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}

	.spec-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		padding: 0.5rem 0.75rem;
		border-radius: 8px;
		font-size: 0.8rem;
		color: #cbd5e1;
	}

	.spec-icon {
		font-size: 0.9rem;
	}

	/* Featured Footer */
	.featured-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.btn-read-featured {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: linear-gradient(135deg, #4f46e5, #6366f1);
		color: #ffffff;
		font-weight: 600;
		font-size: 0.9rem;
		padding: 0.65rem 1.4rem;
		border-radius: 10px;
		text-decoration: none;
		transition: all 0.2s ease;
		box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
	}

	.btn-read-featured:hover {
		background: linear-gradient(135deg, #4338ca, #4f46e5);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
	}

	/* Right Column Terminal Mockup */
	.terminal-mockup {
		background: #080d1a;
		border: 1px solid rgba(99, 102, 241, 0.3);
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6);
	}

	.terminal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: #0d1527;
		padding: 0.6rem 1rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.terminal-dots {
		display: flex;
		gap: 6px;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}

	.dot-red { background: #ef4444; }
	.dot-yellow { background: #f59e0b; }
	.dot-green { background: #10b981; }

	.terminal-title {
		font-family: var(--font-mono, monospace);
		font-size: 0.75rem;
		color: #94a3b8;
	}

	.terminal-badge {
		font-family: var(--font-mono, monospace);
		font-size: 0.65rem;
		background: rgba(16, 185, 129, 0.15);
		color: #34d399;
		padding: 0.1rem 0.4rem;
		border-radius: 4px;
		font-weight: 600;
	}

	.terminal-body {
		padding: 1.25rem;
		font-family: var(--font-mono, monospace);
		font-size: 0.8rem;
		line-height: 1.6;
		color: #e2e8f0;
	}

	.terminal-comment {
		color: #64748b;
		margin-bottom: 0.25rem;
	}

	.terminal-line {
		margin-bottom: 0.35rem;
		word-break: break-all;
	}

	.cmd-prompt {
		color: #38bdf8;
		font-weight: 700;
		margin-right: 0.4rem;
	}

	.cmd-env {
		color: #f43f5e;
	}

	.cmd-var {
		color: #fbbf24;
	}

	.cmd-str {
		color: #34d399;
	}

	.terminal-output {
		margin-top: 1rem;
		padding: 0.75rem;
		background: rgba(15, 23, 42, 0.6);
		border-left: 3px solid #10b981;
		border-radius: 6px;
		color: #94a3b8;
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.status-icon {
		color: #10b981;
		font-weight: 700;
		margin-right: 0.35rem;
	}

	.terminal-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		background: #090e1c;
		padding: 0.6rem 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	.term-tag {
		font-size: 0.7rem;
		color: #94a3b8;
		font-family: var(--font-mono, monospace);
	}

	.term-tag.highlight {
		color: #fcd34d;
		font-weight: 600;
	}

	/* 2. Subsequent Posts Section */
	.subsequent-posts-section {
		margin-top: 3rem;
	}

	.section-divider-title {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 1.75rem;
		letter-spacing: -0.01em;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: 2rem;
	}

	.post-card {
		position: relative;
		background-color: var(--surface-color);
