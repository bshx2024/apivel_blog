---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Retrieve and sort blog posts by date descending
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}

const authorAvatars: Record<string, string> = {
	'Alex Rivera': '/blog/authors/alex-rivera.png',
	'Kenji Tanaka': '/blog/authors/kenji-tanaka.png',
	'Sofia Costa': '/blog/authors/sofia-costa.png',
	'Elena Rostova': '/blog/authors/elena-rostova.png',
};
---



<Layout title="Insights & API Tutorials">
	<section class="hero-section">
		<div class="hero-glow-1"></div>
		<div class="hero-glow-2"></div>
		<div class="hero-content">
			<span class="hero-tag">DEVELOPER HUB</span>
			<h1>APIVALE Engineering Blog</h1>
			<p>Deep dives, tutorials, and benchmarking analysis for building scalable AI products using low-latency unified API routing.</p>
			<div class="featured-badge-banner">
				<a href="/blog/longcat-2-5-api-setup-benchmarks/" class="featured-banner-link">
					<span class="badge-fire">🔥 BREAKING SOTA</span>
					<span class="badge-text">Meituan LongCat 2.5 API (1.6T MoE & 1M Context) Setup & Benchmarks →</span>
				</a>
			</div>
		</div>
	</section>

	<section class="posts-section">
		<div class="posts-grid">
			{sortedPosts.map((post) => {
				const avatarUrl = authorAvatars[post.data.author];
				return (
					<article class="post-card">
						<div class="card-glow"></div>
						<div class="card-content">
							<div class="card-meta">
								<div class="card-tags">
									{post.data.tags.slice(0, 2).map((tag) => (
										<span class="tag-badge">{tag}</span>
									))}
								</div>
								<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
							</div>
							
							<h3 class="card-title">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</h3>
							
							<p class="card-description">{post.data.description}</p>
							
							<div class="card-author">
								<div class="author-avatar">
									{avatarUrl ? (
										<img src={avatarUrl} alt={post.data.author} class="avatar-img" />
									) : (
										post.data.author.split(' ').map(n => n[0]).join('')
									)}
								</div>
								<div class="author-info">
									<span class="author-name">{post.data.author}</span>
									<span class="author-title">{post.data.authorTitle}</span>
								</div>
							</div>
						</div>
					</article>
				);
			})}
		</div>
	</section>
</Layout>

<style>
	/* Hero Section */
	.hero-section {
		position: relative;
		padding: 4rem 0 5rem;
		text-align: center;
		overflow: hidden;
	}

	.hero-glow-1 {
		position: absolute;
		top: -10%;
		left: 20%;
		width: 300px;
		height: 300px;
		background: radial-gradient(circle, var(--primary-color) 0%, transparent 70%);
		opacity: 0.15;
		filter: blur(50px);
		pointer-events: none;
	}

	.hero-glow-2 {
		position: absolute;
		bottom: -10%;
		right: 20%;
		width: 300px;
		height: 300px;
		background: radial-gradient(circle, var(--accent-color) 0%, transparent 70%);
		opacity: 0.15;
		filter: blur(50px);
		pointer-events: none;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 700px;
		margin: 0 auto;
	}

	.hero-tag {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		text-transform: uppercase;
		display: inline-block;
		margin-bottom: 1rem;
	}

	.hero-section h1 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 2.75rem;
		color: var(--text-primary);
		line-height: 1.2;
		margin-bottom: 1.25rem;
		letter-spacing: -0.02em;
	}

	.hero-section p {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.6;
	}

	.featured-badge-banner {
		margin-top: 1.75rem;
		display: inline-block;
	}

	.featured-banner-link {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 1rem;
		background: rgba(99, 102, 241, 0.12);
		border: 1px solid rgba(99, 102, 241, 0.35);
		border-radius: 9999px;
		color: var(--text-primary);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.featured-banner-link:hover {
		background: rgba(99, 102, 241, 0.22);
		border-color: rgba(99, 102, 241, 0.6);
		transform: translateY(-1px);
	}

	.badge-fire {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		background: linear-gradient(135deg, #f59e0b, #ef4444);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		letter-spacing: 0.05em;
	}

	.badge-text {
		color: #e2e8f0;
	}

	/* Posts Grid */
	.posts-section {
		margin-top: 2rem;
		padding-bottom: 4rem;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
		gap: 2rem;
	}

	.post-card {
		position: relative;
		background-color: var(--surface-color);
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		overflow: hidden;
	}

	.post-card:hover {
		transform: translateY(-4px);
		border-color: rgba(99, 102, 241, 0.4);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(99, 102, 241, 0.05);
	}

	.card-glow {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(800px circle at var(--x, 0px) var(--y, 0px), rgba(255, 255, 255, 0.06), transparent 40%);
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.5s;
	}

	.post-card:hover .card-glow {
		opacity: 1;
	}

	.card-content {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.card-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}

	.card-tags {
		display: flex;
		gap: 0.5rem;
	}

	.tag-badge {
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--primary-color);
		background-color: rgba(99, 102, 241, 0.1);
		border: 1px solid rgba(99, 102, 241, 0.15);
		padding: 0.15rem 0.5rem;
		border-radius: 9999px;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.card-meta time {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.card-title {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 600;
		line-height: 1.4;
		margin-bottom: 1rem;
	}

	.card-title a {
		color: var(--text-primary);
		text-decoration: none;
		transition: color 0.2s;
	}

	.card-title a:hover {
		color: var(--primary-color);
	}

	.card-description {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.5;
		margin-bottom: 2rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex-grow: 1;
	}

	.card-author {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: auto;
		border-top: 1px solid rgba(255, 255, 255, 0.04);
		padding-top: 1.25rem;
	}

	.author-avatar {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
		color: var(--text-primary);
		font-weight: 700;
		font-size: 0.85rem;
		display: flex;
		align-items: center;
		justify-content: center;
		letter-spacing: 0.05em;
		overflow: hidden;
	}

	.avatar-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
	}

	.author-info {
		display: flex;
		flex-direction: column;
	}

	.author-name {
		color: var(--text-primary);
		font-weight: 600;
		font-size: 0.85rem;
	}

	.author-title {
		color: var(--text-muted);
		font-size: 0.75rem;
	}

	@media (max-width: 640px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
		.hero-section h1 {
			font-size: 2.25rem;
		}
	}
</style>
